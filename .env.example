# Copia este archivo a .env.local y reemplaza todos los valores de ejemplo.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-project-service-role-key

# Solo servidor: no anteponer NEXT_PUBLIC_.
ACCESS_PIN=replace-with-a-private-pin
SESSION_SECRET=replace-with-at-least-32-random-characters

MEDIA_BUCKET=media
APP_TIME_ZONE=America/Argentina/Buenos_Aires
